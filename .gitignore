# Secrets — never commit
.env
*.env
!frontend/.env.production
backend/.env

# Google service account private keys. A committed SA key is a full credential
# leak, and this repo is PUBLIC — added before any key exists so there is no
# window in which one could be committed by accident.
moneypenny-sa.json
*-sa.json
*service-account*.json
*.json.key

# Security working docs. This repo is PUBLIC — a secrets inventory (which
# credentials exist, where they live, what is already exposed) must not be
# published, even with the values stripped.
CREDENTIAL_ROTATION_CHECKLIST.md
roster_diff_full.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Node / frontend
node_modules/
dist/
build/
.vite/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build artifacts
*.parquet

# AWS deployment artifacts — never commit private keys
deploy/aws/*.pem
deploy/aws/.env
deploy/aws/instance-info.txt
